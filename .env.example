PORT=3000
# Set to production when deployed (HTTPS). Keep development for http://localhost
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/midsoft

# Razorpay Dashboard > Settings > API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard > Settings > Webhooks (you choose this secret)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Login for /admin (change both!)
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# OPTIONAL — emails (payment confirmation to the user + contact messages to you).
# For Gmail: turn on 2-step verification, then create an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=midsoftglobal@gmail.com
SMTP_PASS=your-16-letter-app-password
# CONTACT_TO=midsoftglobal@gmail.com

# OPTIONAL — stop NEW registrations after this moment (existing ones can still pay)
# REGISTRATION_CLOSES=2026-11-30T23:59:59+05:30
